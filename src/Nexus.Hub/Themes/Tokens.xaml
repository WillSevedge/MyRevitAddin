<!--
  Nexus design tokens: type scale, spacing, corner radii and the shared control styles of the hub.
  Colours come from Palette.Light.xaml / Palette.Dark.xaml (swapped by AppTheme), so everything here uses
  DynamicResource for brushes. Styles here must not be BasedOn the Windows 11 (Fluent) styles: this dictionary
  loads before the theme is applied. Window-level styles can derive from them.

  Spacing scale: 4 / 8 / 12 / 16 / 24 / 32.   Radii: 4 (small) / 6 (controls) / 10 (cards, panels).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

  <BooleanToVisibilityConverter x:Key="BoolToVis" />
  <!-- Icons: Segoe Fluent Icons on Windows 11, Segoe MDL2 Assets on Windows 10. -->
  <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

  <!-- ===================== Type ===================== -->
  <FontFamily x:Key="Nexus.Font">Segoe UI Variable Text, Segoe UI</FontFamily>
  <sys:Double x:Key="Nexus.FontSize.Heading">22</sys:Double>
  <sys:Double x:Key="Nexus.FontSize.Section">16</sys:Double>
  <sys:Double x:Key="Nexus.FontSize.Body">13</sys:Double>
  <sys:Double x:Key="Nexus.FontSize.Small">12</sys:Double>
  <sys:Double x:Key="Nexus.FontSize.Caption">11</sys:Double>

  <!-- ===================== Shape ===================== -->
  <CornerRadius x:Key="Nexus.Radius.Small">4</CornerRadius>
  <CornerRadius x:Key="Nexus.Radius.Control">6</CornerRadius>
  <CornerRadius x:Key="Nexus.Radius.Panel">10</CornerRadius>

  <!-- 61 = 60 inside + the 1 px edge: the icon column (x = 30) is the centre of the collapsed rail. -->
  <sys:Double x:Key="Nexus.Rail.Collapsed">61</sys:Double>
  <sys:Double x:Key="Nexus.Rail.Expanded">228</sys:Double>
  <sys:Double x:Key="Nexus.Inspector.Width">340</sys:Double>

  <!-- ===================== Text ===================== -->
  <Style x:Key="Nexus.Text.Heading" TargetType="TextBlock">
    <Setter Property="FontSize" Value="{StaticResource Nexus.FontSize.Heading}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Nexus.Text}" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>
  <Style x:Key="Nexus.Text.Section" TargetType="TextBlock">
    <Setter Property="FontSize" Value="{StaticResource Nexus.FontSize.Section}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Nexus.Text}" />
  </Style>
  <Style x:Key="Nexus.Text.Body" TargetType="TextBlock">
    <Setter Property="FontSize" Value="{StaticResource Nexus.FontSize.Body}" />
    <Setter Property="Foreground" Value="{DynamicResource Nexus.Text}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style x:Key="Nexus.Text.Secondary" TargetType="TextBlock">
    <Setter Property="FontSize" Value="{StaticResource Nexus.FontSize.Body}" />
    <Setter Property="Foreground" Value="{DynamicResource Nexus.TextSecondary}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style x:Key="Nexus.Text.Caption" TargetType="TextBlock">
    <Setter Property="FontSize" Value="{StaticResource Nexus.FontSize.Caption}" />
    <Setter Property="Foreground" Value="{DynamicResource Nexus.TextSecondary}" />
  </Style>
  <!-- Small caps label above a group ("SOURCES", "VIEWS"). -->
  <Style x:Key="Nexus.Text.Overline" TargetType="TextBlock">
    <Setter Property="FontSize" Value="{StaticResource Nexus.FontSize.Caption}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Nexus.TextTertiary}" />
    <Setter Property="Margin" Value="12,16,12,6" />
  </Style>

  <Style x:Key="Glyph" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- ===================== Surfaces ===================== -->
  <Style x:Key="Nexus.Card" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource Nexus.Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Nexus.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource Nexus.Radius.Panel}" />
  </Style>

  <!-- Small rounded label: "Revit 2026", "3 selected", "Busy". -->
  <Style x:Key="Nexus.Chip" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource Nexus.SurfaceAlt}" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="8,2" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style x:Key="Nexus.Divider" TargetType="Rectangle">
    <Setter Property="Width" Value="1" />
    <Setter Property="Height" Value="20" />
    <Setter Property="Margin" Value="6,0" />
    <Setter Property="Fill" Value="{DynamicResource Nexus.Border}" />
  </Style>

  <!-- ===================== Buttons ===================== -->
  <!-- Flat icon + text button for command bars. -->
  <Style x:Key="Nexus.CommandButton" TargetType="Button">
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="10,6" />
    <Setter Property="Margin" Value="2,0" />
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Foreground" Value="{DynamicResource Nexus.Text}" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="{StaticResource Nexus.Radius.Control}"
                  Padding="{TemplateBinding Padding}" BorderThickness="1" BorderBrush="Transparent">
            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Nexus.Hover}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Nexus.Pressed}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource Nexus.Accent}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.4" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="Nexus.CommandToggle" TargetType="ToggleButton">
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="10,6" />
    <Setter Property="Margin" Value="2,0" />
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Foreground" Value="{DynamicResource Nexus.Text}" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="{StaticResource Nexus.Radius.Control}"
                  Padding="{TemplateBinding Padding}" BorderThickness="1" BorderBrush="Transparent">
            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Nexus.Hover}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Nexus.AccentSubtle}" />
              <Setter Property="Foreground" Value="{DynamicResource Nexus.Accent}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource Nexus.Accent}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.4" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Square icon-only button (close, pin, overflow). -->
  <Style x:Key="Nexus.IconButton" TargetType="Button" BasedOn="{StaticResource Nexus.CommandButton}">
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="1,0" />
    <Setter Property="Width" Value="32" />
    <Setter Property="Height" Value="32" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
  </Style>

  <!-- Square icon-only toggle (density, inspector, health). -->
  <Style x:Key="Nexus.IconToggle" TargetType="ToggleButton" BasedOn="{StaticResource Nexus.CommandToggle}">
    <Setter Property="Padding" Value="0" />
    <Setter Property="Width" Value="32" />
    <Setter Property="Height" Value="32" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Margin" Value="1,0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
  </Style>

  <!-- Filled accent button: the one main action of a panel. -->
  <Style x:Key="Nexus.PrimaryButton" TargetType="Button">
    <Setter Property="Background" Value="{DynamicResource Nexus.Accent}" />
    <Setter Property="Foreground" Value="{DynamicResource Nexus.OnAccent}" />
    <Setter Property="Padding" Value="14,6" />
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="{StaticResource Nexus.Radius.Control}"
                  Padding="{TemplateBinding Padding}" BorderThickness="1" BorderBrush="Transparent">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Nexus.AccentHover}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource Nexus.Text}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.45" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Outlined button: secondary actions next to a primary one. -->
  <Style x:Key="Nexus.SecondaryButton" TargetType="Button">
    <Setter Property="Background" Value="{DynamicResource Nexus.Surface}" />
    <Setter Property="Foreground" Value="{DynamicResource Nexus.Text}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Nexus.Border}" />
    <Setter Property="Padding" Value="14,6" />
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="{StaticResource Nexus.Radius.Control}"
                  Padding="{TemplateBinding Padding}" BorderThickness="1" BorderBrush="{TemplateBinding BorderBrush}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Nexus.Hover}" />
              <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource Nexus.BorderStrong}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource Nexus.Accent}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.45" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===================== Navigation rail ===================== -->
  <!-- A workspace in the rail: icon, label when expanded, accent bar when selected. -->
  <Style x:Key="Nexus.RailItem" TargetType="RadioButton">
    <Setter Property="Foreground" Value="{DynamicResource Nexus.TextSecondary}" />
    <Setter Property="Margin" Value="8,2" />
    <Setter Property="Height" Value="40" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Border x:Name="Bg" Background="Transparent" CornerRadius="{StaticResource Nexus.Radius.Control}" BorderThickness="1" BorderBrush="Transparent">
            <Grid>
              <Border x:Name="Pill" Width="3" Height="18" CornerRadius="2" HorizontalAlignment="Left" Margin="-1,0,0,0"
                      Background="{DynamicResource Nexus.Accent}" Visibility="Collapsed" />
              <ContentPresenter Margin="11,0,8,0" VerticalAlignment="Center" />
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Nexus.Hover}" />
              <Setter Property="Foreground" Value="{DynamicResource Nexus.Text}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Nexus.AccentSubtle}" />
              <Setter TargetName="Pill" Property="Visibility" Value="Visible" />
              <Setter Property="Foreground" Value="{DynamicResource Nexus.Accent}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource Nexus.Accent}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- A tool in the rail (opens a window): same look, no selected state. -->
  <Style x:Key="Nexus.RailButton" TargetType="Button">
    <Setter Property="Foreground" Value="{DynamicResource Nexus.TextSecondary}" />
    <Setter Property="Margin" Value="8,2" />
    <Setter Property="Height" Value="40" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bg" Background="Transparent" CornerRadius="{StaticResource Nexus.Radius.Control}" BorderThickness="1" BorderBrush="Transparent">
            <ContentPresenter Margin="11,0,8,0" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Nexus.Hover}" />
              <Setter Property="Foreground" Value="{DynamicResource Nexus.Text}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Nexus.Pressed}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource Nexus.Accent}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.4" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- The rail's menu button: a 40 px square with its icon centred, on the icon column in both rail states. -->
  <Style x:Key="Nexus.RailToggle" TargetType="Button">
    <Setter Property="Foreground" Value="{DynamicResource Nexus.TextSecondary}" />
    <Setter Property="Width" Value="40" />
    <Setter Property="Height" Value="40" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="Margin" Value="10,0,0,8" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bg" Background="Transparent" CornerRadius="{StaticResource Nexus.Radius.Control}" BorderThickness="1" BorderBrush="Transparent">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Nexus.Hover}" />
              <Setter Property="Foreground" Value="{DynamicResource Nexus.Text}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Nexus.Pressed}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource Nexus.Accent}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- A view in the Sheets workspace's explorer list (Sheets, Revisions…). -->
  <Style x:Key="Nexus.NavItem" TargetType="ListBoxItem">
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="8,1" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Foreground" Value="{DynamicResource Nexus.Text}" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Border x:Name="Bg" CornerRadius="{StaticResource Nexus.Radius.Control}" Background="Transparent" Padding="8,6"
                  BorderThickness="1" BorderBrush="Transparent">
            <Grid>
              <Border x:Name="Pill" Width="3" Height="16" CornerRadius="2" HorizontalAlignment="Left" Margin="-7,0,0,0"
                      Background="{DynamicResource Nexus.Accent}" Visibility="Collapsed" />
              <ContentPresenter Margin="4,0,0,0" />
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Nexus.Hover}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Nexus.AccentSubtle}" />
              <Setter TargetName="Pill" Property="Visibility" Value="Visible" />
              <Setter Property="Foreground" Value="{DynamicResource Nexus.Accent}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource Nexus.Accent}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Filter chip: a radio button that looks like a pill with a count. -->
  <Style x:Key="Nexus.FilterChip" TargetType="RadioButton">
    <Setter Property="Margin" Value="0,0,6,0" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Foreground" Value="{DynamicResource Nexus.Text}" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Border x:Name="Bg" CornerRadius="14" Padding="12,5" Background="{DynamicResource Nexus.Surface}"
                  BorderBrush="{DynamicResource Nexus.Border}" BorderThickness="1">
            <ContentPresenter VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Nexus.Hover}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Nexus.AccentSubtle}" />
              <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource Nexus.Accent}" />
              <Setter Property="Foreground" Value="{DynamicResource Nexus.Accent}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource Nexus.Accent}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===================== Tables ===================== -->
  <!-- The hub's table look (the main grid and the deliverables window): a DataGrid uses them as implicit styles. -->
  <Style x:Key="Nexus.GridCell" TargetType="DataGridCell">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource Nexus.Text}" />
    <Setter Property="Padding" Value="11,0" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="DataGridCell">
          <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" SnapsToDevicePixels="True">
            <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center" SnapsToDevicePixels="True" />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="IsSelected" Value="True">
        <Setter Property="Background" Value="{DynamicResource Nexus.GridSelection}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Nexus.GridSelection}" />
      </Trigger>
      <!-- The current cell: an accent outline (keyboard and editing position). -->
      <MultiTrigger>
        <MultiTrigger.Conditions>
          <Condition Property="IsSelected" Value="True" />
          <Condition Property="IsKeyboardFocusWithin" Value="True" />
        </MultiTrigger.Conditions>
        <Setter Property="BorderBrush" Value="{DynamicResource Nexus.Accent}" />
      </MultiTrigger>
      <Trigger Property="IsEditing" Value="True">
        <Setter Property="Background" Value="{DynamicResource Nexus.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Nexus.Accent}" />
      </Trigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="Nexus.GridRow" TargetType="DataGridRow">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{DynamicResource Nexus.GridRowHover}" />
      </Trigger>
    </Style.Triggers>
  </Style>
  <!-- Row marker on the left: click to select the whole row; an accent bar when it is selected. -->
  <Style x:Key="Nexus.GridRowHeader" TargetType="DataGridRowHeader">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="DataGridRowHeader">
          <Grid Background="{TemplateBinding Background}">
            <Border x:Name="Bar" Width="3" CornerRadius="1.5" Margin="3,4,0,4" HorizontalAlignment="Left"
                    Background="{DynamicResource Nexus.Accent}" Visibility="Collapsed" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter Property="Background" Value="{DynamicResource Nexus.Hover}" />
            </Trigger>
            <Trigger Property="IsRowSelected" Value="True">
              <Setter TargetName="Bar" Property="Visibility" Value="Visible" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="Nexus.HeaderGripper" TargetType="Thumb">
    <Setter Property="Width" Value="8" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Cursor" Value="SizeWE" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Thumb">
          <Border Background="{TemplateBinding Background}" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <!-- Column header: one line, sort arrow, a hairline between columns, resize by dragging the edge. -->
  <Style x:Key="Nexus.GridColumnHeader" TargetType="DataGridColumnHeader">
    <Setter Property="Background" Value="{DynamicResource Nexus.GridHeader}" />
    <Setter Property="Foreground" Value="{DynamicResource Nexus.TextSecondary}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Nexus.Border}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="MinHeight" Value="36" />
    <Setter Property="Padding" Value="12,0,8,0" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="DataGridColumnHeader">
          <Grid>
            <Border x:Name="Bg" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0,0,0,1">
              <DockPanel Margin="{TemplateBinding Padding}">
                <TextBlock x:Name="SortArrow" DockPanel.Dock="Right" FontFamily="{StaticResource IconFont}" FontSize="10"
                           Margin="6,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource Nexus.Accent}" Visibility="Collapsed" />
                <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="False" />
              </DockPanel>
            </Border>
            <Rectangle x:Name="Separator" Width="1" HorizontalAlignment="Right" Margin="0,10" Fill="{DynamicResource Nexus.Border}" />
            <Thumb x:Name="PART_LeftHeaderGripper" HorizontalAlignment="Left" Style="{StaticResource Nexus.HeaderGripper}" />
            <Thumb x:Name="PART_RightHeaderGripper" HorizontalAlignment="Right" Style="{StaticResource Nexus.HeaderGripper}" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Nexus.Hover}" />
            </Trigger>
            <Trigger Property="SortDirection" Value="Ascending">
              <Setter TargetName="SortArrow" Property="Text" Value="&#xE70E;" />
              <Setter TargetName="SortArrow" Property="Visibility" Value="Visible" />
              <Setter Property="Foreground" Value="{DynamicResource Nexus.Text}" />
            </Trigger>
            <Trigger Property="SortDirection" Value="Descending">
              <Setter TargetName="SortArrow" Property="Text" Value="&#xE70D;" />
              <Setter TargetName="SortArrow" Property="Visibility" Value="Visible" />
              <Setter Property="Foreground" Value="{DynamicResource Nexus.Text}" />
            </Trigger>
            <!-- The filler right of the last column: no hairline. -->
            <Trigger Property="DisplayIndex" Value="-1">
              <Setter TargetName="Separator" Property="Visibility" Value="Collapsed" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
